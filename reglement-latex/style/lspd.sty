% ---------------------------------------------------------------
%  Typographie
% ---------------------------------------------------------------
% Les fontes Inter sont embarquées dans le dossier fonts/ : le document
% compile ainsi à l'identique partout (Overleaf, TeX Live local, etc.).
\setmainfont{TeX Gyre Pagella}[
  Numbers   = OldStyle ,
  Ligatures = TeX ]
\newfontfamily\lspdsans{Inter}[
  Path = fonts/ , Extension = .otf ,
  UprightFont = *-Regular , BoldFont = *-Bold , ItalicFont = *-Italic ,
  Ligatures = TeX ]
\newfontfamily\lspdsansmed{Inter}[
  Path = fonts/ , Extension = .otf ,
  UprightFont = *-Medium , BoldFont = *-Bold , ItalicFont = *-Italic ,
  Ligatures = TeX ]
\newfontfamily\lspdsansbk{Inter}[
  Path = fonts/ , Extension = .otf ,
  UprightFont = *-SemiBold , BoldFont = *-Black ,
  Ligatures = TeX ]
\newfontfamily\lspddisp{InterDisplay}[
  Path = fonts/ , Extension = .otf ,
  UprightFont = *-SemiBold , BoldFont = *-Black ,
  AutoFakeSlant = 0.15 ,
  Ligatures = TeX ]

\linespread{1.06}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\color{lspdink}

% Lettrage espacé pour les titres
\newcommand{\lsp}[2][.14em]{%
  \begingroup\addfontfeature{LetterSpace=8}\textls*{#2}\endgroup}
\newcommand{\capsline}[1]{{\lspdsansbk\fontsize{9}{11}\selectfont
  \addfontfeature{LetterSpace=18}\MakeUppercase{#1}}}

% ---------------------------------------------------------------
%  Compteurs : articles, alinéas
% ---------------------------------------------------------------
\newcounter{lspdart}
\newcounter{lspdclause}[lspdart]
\newcommand{\artnum}{\arabic{lspdart}}
\newcommand{\artroman}{\MakeUppercase{\romannumeral\value{lspdart}}}
\newcommand{\clausenum}{\artnum.\ifnum\value{lspdclause}<10 0\fi\arabic{lspdclause}}
% Les renvois (\refcl) doivent restituer le numéro complet « 12.04 »
\renewcommand{\thelspdclause}{\clausenum}
\renewcommand{\thelspdart}{\artroman}

% ---------------------------------------------------------------
%  Filets et ornements
% ---------------------------------------------------------------
\newcommand{\lspdrulewide}[1][\linewidth]{%
  \par\nointerlineskip
  \begin{tikzpicture}
    \fill[lspdnavy] (0,0) rectangle (#1,1.1pt);
  \end{tikzpicture}\par\nointerlineskip}

\newcommand{\lspdrulethin}[1][\linewidth]{%
  \par\nointerlineskip
  \begin{tikzpicture}
    \fill[lspdrule] (0,0) rectangle (#1,.5pt);
  \end{tikzpicture}\par\nointerlineskip}

% Séparateur décoratif : filet, losange or, filet
\newcommand{\lspdornament}{%
  \par\vspace{10pt}
  \centerline{%
    \begin{tikzpicture}
      \fill[lspdrule] (0,0) rectangle (4.6cm,.4pt);
      \fill[lspdgold] (5.0cm,-2.1pt) -- (5.21cm,0) -- (5.0cm,2.1pt) -- (4.79cm,0) -- cycle;
      \fill[lspdnavy] (5.45cm,-1.6pt) -- (5.61cm,0) -- (5.45cm,1.6pt) -- (5.29cm,0) -- cycle;
      \fill[lspdgold] (5.85cm,-2.1pt) -- (6.06cm,0) -- (5.85cm,2.1pt) -- (5.64cm,0) -- cycle;
      \fill[lspdrule] (6.45cm,0) rectangle (11.05cm,.4pt);
    \end{tikzpicture}}
  \par\vspace{10pt}}

