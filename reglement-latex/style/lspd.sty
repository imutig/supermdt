% applique le filet sur toutes les pages du corps
\newcommand{\lspdactivaterules}{%
  \AddToShipoutPictureBG{%
    \ifnum\value{page}>0
      \AtPageUpperLeft{\raisebox{-25mm}{\hspace{24mm}%
        \begin{tikzpicture}
          \fill[lspdnavy] (0,0) rectangle (\dimexpr\paperwidth-48mm\relax,.9pt);
          \fill[lspdgold] (0,-1.7mm) rectangle (2.4cm,.7pt);
        \end{tikzpicture}}}%
      \AtPageLowerLeft{\raisebox{18.5mm}{\hspace{24mm}%
        \begin{tikzpicture}
          \fill[lspdrule] (0,0) rectangle (\dimexpr\paperwidth-48mm\relax,.4pt);
        \end{tikzpicture}}}%
    \fi}}

% ---------------------------------------------------------------
%  Page de titre de partie (TITRE I, TITRE II…)
% ---------------------------------------------------------------
\newcommand{\titrepartie}[2]{%
  \clearpage
  \renewcommand{\lspdcourant}{#1}
  \thispagestyle{empty}
  \phantomsection
  \addcontentsline{toc}{part}{#1 : #2}
  \begingroup
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{%
      \begin{tikzpicture}[remember picture,overlay]
        \fill[lspddeep] (0,0) rectangle (\paperwidth,\paperheight);
        % cadre or
        \draw[lspdgold,line width=.6pt]
          (12mm,12mm) rectangle (\dimexpr\paperwidth-12mm\relax,\dimexpr\paperheight-12mm\relax);
        \draw[lspdgold!55,line width=.3pt]
          (14.5mm,14.5mm) rectangle (\dimexpr\paperwidth-14.5mm\relax,\dimexpr\paperheight-14.5mm\relax);
        % sceau en filigrane
        \node[opacity=.055] at (\paperwidth/2,\paperheight/2)
          {\includegraphics[width=13cm]{images/sceau-lspd.png}};
      \end{tikzpicture}}}%
  \null\vfill
  \begin{center}
    \includegraphics[width=26mm]{images/sceau-lspd.png}\\[13mm]
    {\lspdsans\fontsize{9}{11}\selectfont\color{lspdgoldlt}%
      \addfontfeature{LetterSpace=26}\MakeUppercase{Los Santos Police Department}}\\[7mm]
    \begin{tikzpicture}\fill[lspdgold] (0,0) rectangle (2.6cm,.8pt);\end{tikzpicture}\\[7mm]
    {\lspddisp\fontsize{15}{18}\selectfont\color{lspdgoldlt}%
      \addfontfeature{LetterSpace=34}\MakeUppercase{#1}}\\[8mm]
    {\lspddisp\fontsize{25}{31}\selectfont\color{white}%
      \addfontfeature{LetterSpace=6}\MakeUppercase{#2}}\\[10mm]
    \begin{tikzpicture}\fill[lspdgold] (0,0) rectangle (1.4cm,.8pt);\end{tikzpicture}
  \end{center}
  \vfill\null
  \endgroup
  \clearpage}

% ---------------------------------------------------------------
%  Articles
% ---------------------------------------------------------------
% \article{Intitulé}   -> ARTICLE VII / Intitulé
\newcommand{\articlelabel}{}
% Chaque article démarre en haut d'une page : plus aucun titre d'article
% ne peut se retrouver isolé en bas de page.
\newcommand{\article}[1]{%
  \clearpage
  \refstepcounter{lspdart}%
  \phantomsection
  \addcontentsline{toc}{section}{\protect\numberline{Art.~\artroman}#1}%
  \begingroup
  \noindent
  \begin{tikzpicture}
    \fill[lspdnavy] (0,0) rectangle (\linewidth,1.1pt);
  \end{tikzpicture}\\[3.2pt]
  \noindent
  {\lspdsansbk\fontsize{8.2}{10}\selectfont\color{lspdgold}%
    \addfontfeature{LetterSpace=22}\MakeUppercase{Article \artroman}}\\[2.5pt]
  \noindent
  {\lspddisp\fontsize{15.5}{18}\selectfont\color{lspdnavy}#1}\\[3pt]
  \noindent
  \begin{tikzpicture}
    \fill[lspdgold] (0,0) rectangle (2.2cm,.9pt);
  \end{tikzpicture}
  \endgroup
  \par\vspace{9pt}}

% Chapeau introductif d'article (italique gris)
\newcommand{\chapeau}[1]{%
  \par{\itshape\color{lspdgrey}\small #1}\par\vspace{7pt}}

% ---- Alinéas numérotés -------------------------------------------------
% \cl{Texte}                 -> [7.01] Texte
% \cl[cle]{Texte}            -> idem + étiquette référençable par \refcl{cle}
\newcommand{\cl}[2][]{%
  \par\needspace{2.2\baselineskip}\vspace{5.2pt}
  \refstepcounter{lspdclause}%
  \if\relax\detokenize{#1}\relax\else\label{cl:#1}\fi
  \noindent
  \hangindent=13mm \hangafter=1
  \makebox[13mm][l]{{\lspdsansbk\fontsize{8.4}{10}\selectfont\color{lspdblue}%
     [\clausenum]}}%
  \justifying #2\par}

% Alinéa avec intitulé en tête
\newcommand{\cln}[3][]{%
  \par\needspace{2.2\baselineskip}\vspace{5.2pt}
  \refstepcounter{lspdclause}%
  \if\relax\detokenize{#1}\relax\else\label{cl:#1}\fi
  \noindent
  \hangindent=13mm \hangafter=1
  \makebox[13mm][l]{{\lspdsansbk\fontsize{8.4}{10}\selectfont\color{lspdblue}%
     [\clausenum]}}%
  \justifying{\lspdsansbk\fontsize{10}{12}\selectfont\color{lspdnavy}#2.}\ #3\par}

% Texte courant rattaché à l'alinéa précédent (indenté)
\newcommand{\clsuite}[1]{%
  \par\vspace{3.6pt}\noindent\hspace*{13mm}%
  \begin{minipage}{\dimexpr\linewidth-13mm\relax}\justifying #1\end{minipage}\par}

% Référence croisée : \refcl{cle} -> [7.03]
\newcommand{\refcl}[1]{{\lspdsansmed\fontsize{9.4}{11}\selectfont
   \color{lspdblue}[\ref{cl:#1}]}}

% Intertitre à l'intérieur d'un article
\newcommand{\sstitre}[1]{%
  \par\needspace{6\baselineskip}\vspace{11pt}
  \noindent{\lspdsansbk\fontsize{9.4}{11}\selectfont\color{lspdnavy}%
    \addfontfeature{LetterSpace=10}\MakeUppercase{#1}}\\[2.5pt]
  \noindent\begin{tikzpicture}\fill[lspdrule] (0,0) rectangle (\linewidth,.5pt);\end{tikzpicture}
  \par\vspace{1pt}\nopagebreak[4]}

% ---------------------------------------------------------------
%  Listes
% ---------------------------------------------------------------
% Puce dessinée en TikZ : la couleur est encapsulée dans l'image, ce qui évite
% les fuites de pile de couleurs aux changements de page ou de colonne.
\newcommand{\lspdbullet}{%
  \tikz[baseline]{\fill[lspdgold]
    (0,.26em) -- (1.9pt,.44em) -- (3.8pt,.26em) -- (1.9pt,.08em) -- cycle;}}
\newcommand{\lspdsubbullet}{%
  \tikz[baseline]{\draw[lspdgrey,line width=.5pt] (1.3pt,.26em) circle (1.3pt);}}
\setlist[itemize,1]{leftmargin=18mm,labelsep=3mm,itemsep=2.4pt,topsep=4pt,
  label=\protect\lspdbullet}
\setlist[itemize,2]{leftmargin=6mm,labelsep=2.5mm,itemsep=1.6pt,topsep=2.5pt,
  label=\protect\lspdsubbullet}
\setlist[enumerate,1]{leftmargin=18mm,labelsep=3mm,itemsep=2.8pt,topsep=4pt,
  label=\protect\lspdnum{\arabic*}}
\setlist[enumerate,2]{leftmargin=7mm,labelsep=2.5mm,itemsep=1.8pt,topsep=2.5pt,
  label=\protect\lspdalph{\alph*}}
\newcommand{\lspdalph}[1]{%
  \tikz[baseline=(n.base)]{\node[inner sep=0pt,text=lspdblue,
    font=\lspdsansbk\fontsize{8.4}{9}\selectfont] (n) {#1.};}}
\newcommand{\lspdnum}[1]{%
  \tikz[baseline=(n.base)]{
    \node[fill=lspdnavy,text=white,inner sep=0pt,minimum width=4.6mm,
          minimum height=4.6mm,rounded corners=.6pt,
          font=\lspdsansbk\fontsize{7.6}{8}\selectfont] (n) {#1};}}

% Liste de définitions (glossaire)
\newenvironment{definitions}
  {\begin{list}{}{\setlength{\leftmargin}{18mm}\setlength{\labelsep}{3mm}
    \setlength{\itemsep}{4pt}\setlength{\topsep}{5pt}
    \renewcommand{\makelabel}[1]{\hss\llap{##1}}}}
  {\end{list}}
\newcommand{\dterme}[1]{\item[{\lspdsansbk\fontsize{9.6}{11}\selectfont
   \color{lspdnavy}#1}]}

% ---------------------------------------------------------------
%  Encadrés
% ---------------------------------------------------------------
\newtcolorbox{lspdbox}[2][]{%
  enhanced, breakable, sharp corners,
  colback=#2!8, colframe=#2, boxrule=0pt,
  leftrule=2.6pt, toprule=0pt, bottomrule=0pt, rightrule=0pt,
  left=6mm, right=5mm, top=4mm, bottom=4mm,
  before skip=10pt, after skip=10pt, #1}

\newcommand{\boxtitle}[2]{%
  {\lspdsansbk\fontsize{8.2}{10}\selectfont\color{#1}%
   \addfontfeature{LetterSpace=18}\MakeUppercase{#2}}\par\vspace{3.5pt}}

% Note / précision
\newenvironment{note}[1][Note]
  {\needspace{8\baselineskip}\begin{lspdbox}{lspdblue}\boxtitle{lspdblue}{#1}\justifying\small}
  {\end{lspdbox}}
% Interdiction / sanction
\newenvironment{interdit}[1][Interdiction]
  {\needspace{8\baselineskip}\begin{lspdbox}{lspdred}\boxtitle{lspdred}{#1}\justifying\small}
  {\end{lspdbox}}
% Bonne pratique / rappel positif
\newenvironment{rappel}[1][Rappel]
  {\needspace{8\baselineskip}\begin{lspdbox}{lspdgreen}\boxtitle{lspdgreen}{#1}\justifying\small}
  {\end{lspdbox}}
% Encadré solennel (or)
\newenvironment{solennel}[1][]
  {\needspace{8\baselineskip}\begin{lspdbox}{lspdgold}\if\relax\detokenize{#1}\relax\else
     \boxtitle{lspdgold!70!black}{#1}\fi\justifying\small}
  {\end{lspdbox}}

% Citation encadrée pleine largeur (serment, Miranda…)
\newtcolorbox{formule}[1][]{%
  enhanced, breakable=false, sharp corners,
  colback=lspddeep, colframe=lspdgold, boxrule=.7pt,
  left=9mm, right=9mm, top=7mm, bottom=7mm,
  before skip=13pt, after skip=13pt,
  fontupper=\color{white}\itshape, #1}

% ---------------------------------------------------------------
%  Tableaux
% ---------------------------------------------------------------
\renewcommand{\arraystretch}{1.34}
\setlength{\arrayrulewidth}{.4pt}
\arrayrulecolor{lspdrule}

% Police commune à toutes les cellules : appliquée par la colonne, jamais par
% la cellule, afin que toutes les lignes partagent la même ligne de base.
\newcommand{\lspdtabfont}{\lspdsansmed\fontsize{9.2}{12.4}\selectfont}
\newcommand{\thead}[1]{{\leavevmode\lspdsansbk\color{white}%
  \addfontfeature{LetterSpace=12}\MakeUppercase{\fontsize{8.2}{12.4}\selectfont #1}}}
\newcommand{\headrow}{\rowcolor{lspdnavy}}
\newcommand{\altrow}{\rowcolor{lspdpaper}}
\newcommand{\tcell}[1]{\leavevmode #1}
\newcommand{\tkey}[1]{{\leavevmode\lspdsansbk\color{lspdnavy}#1}}

% colonnes à largeur fixe, alignées en haut
\newcolumntype{P}[1]{>{\RaggedRight\arraybackslash\lspdtabfont}p{#1}}
\newcolumntype{C}[1]{>{\Centering\arraybackslash\lspdtabfont}p{#1}}

% ---------------------------------------------------------------
%  Sommaire
% ---------------------------------------------------------------
\newcommand{\lspdtoc}{%
  \clearpage
  \renewcommand{\lspdcourant}{Sommaire}
  \begingroup
  {\lspddisp\fontsize{22}{26}\selectfont\color{lspdnavy}Sommaire}\\[4pt]
  \lspdrulewide\vspace{3pt}
  \noindent\begin{tikzpicture}\fill[lspdgold] (0,0) rectangle (2.6cm,.9pt);\end{tikzpicture}
  \vspace{12pt}
  \setlength{\columnsep}{9mm}
  \@starttoc{toc}
  \endgroup
  \clearpage}

\titlecontents{part}[0pt]
  {\addvspace{13pt}\lspdsansbk\fontsize{9.4}{11}\selectfont\color{lspdnavy}
   \addfontfeature{LetterSpace=14}}
  {}{}
  {\hfill\normalfont\lspdsansmed\fontsize{8.4}{10}\selectfont\color{lspdgrey}\thecontentspage}
  [\vspace{1.5pt}{\color{lspdgold}\hrule height .9pt}\vspace{4.5pt}]

\titlecontents{section}[19mm]
  {\addvspace{1.6pt}\small}
  {\hspace*{-19mm}\makebox[19mm][l]{\lspdsansbk\fontsize{8}{10}\selectfont
     \color{lspdgold}\thecontentslabel}}
  {\hspace*{-19mm}\makebox[19mm][l]{}}
  {\hspace{2mm}\titlerule*[.7em]{\color{lspdrule}.}\hspace{1.5mm}%
   \normalfont\lspdsansmed\fontsize{8.6}{10}\selectfont\color{lspdnavy}\thecontentspage}

\makeatletter
\renewcommand{\@pnumwidth}{0pt}
